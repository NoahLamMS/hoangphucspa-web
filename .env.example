# Mẫu biến môi trường cho web. Sao chép thành .env.local rồi điền giá trị (không commit .env.local).
# API nội bộ cho Server Component (backend ASP.NET Core)
API_INTERNAL_URL=http://localhost:5080
# Đích của rewrites /api, /images, /media khi chạy dev
API_ORIGIN=http://localhost:5080
# Secret của webhook /internal/revalidate: phải trùng khoá Web:RevalidateSecret của backend (user-secrets)
REVALIDATE_SECRET=
# Domain công khai (đọc lúc build). Local: http://localhost:3000
SITE_URL=http://localhost:3000
# GA4 (tuỳ chọn, để trống ở local)
GA_MEASUREMENT_ID=
# Chỉ đặt true khi đã chọn domain chính thức và đồng ý cho index; để trống = noindex
ALLOW_INDEXING=
